root = true

# ============================================================
# General
# ============================================================

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true


# ============================================================
# C# files
# ============================================================

[*.cs]

# ------------------------------------------------------------
# Indentation
# ------------------------------------------------------------

indent_style = space
indent_size = 4
tab_width = 4


# ------------------------------------------------------------
# Namespace
# ------------------------------------------------------------

# Generates:
#
# namespace My.Namespace;
#
# Instead of:
#
# namespace My.Namespace
# {
# }
#
csharp_style_namespace_declarations = file_scoped:error


# ------------------------------------------------------------
# VAR
# ------------------------------------------------------------

# Do not use var for built-in types
csharp_style_var_for_built_in_types = false:error

# Do not use var when the type is obvious
csharp_style_var_when_type_is_apparent = false:error

# Do not use var elsewhere
csharp_style_var_elsewhere = false:error


# ------------------------------------------------------------
# Using directives
# ------------------------------------------------------------

# System namespaces first
dotnet_sort_system_directives_first = true

# Do not separate using groups
dotnet_separate_import_directive_groups = false

# Prefer using outside namespace
csharp_using_directive_placement = outside_namespace:error


# ------------------------------------------------------------
# Object creation
# ------------------------------------------------------------

# Prefer:
# MyClass instance = new();
#
# Instead of:
# MyClass instance = new MyClass();
#
csharp_style_implicit_object_creation_when_type_is_apparent = true:suggestion


# ------------------------------------------------------------
# Expression-bodied members
# ------------------------------------------------------------

csharp_style_expression_bodied_methods = false:suggestion
csharp_style_expression_bodied_constructors = false:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion


# ------------------------------------------------------------
# Braces
# ------------------------------------------------------------

# Always require braces
csharp_prefer_braces = true:error


# ------------------------------------------------------------
# this.
# ------------------------------------------------------------

dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion


# ------------------------------------------------------------
# Built-in types
# ------------------------------------------------------------

# Prefer:
# string
# int
# bool
#
# Instead of:
# String
# Int32
# Boolean
#
dotnet_style_predefined_type_for_locals_parameters_members = true:error
dotnet_style_predefined_type_for_member_access = true:error


# ------------------------------------------------------------
# Null handling
# ------------------------------------------------------------

dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion


# ------------------------------------------------------------
# Simplification
# ------------------------------------------------------------

dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion

csharp_style_prefer_simple_using_statement = true:suggestion
csharp_style_prefer_simple_default_expression = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_not_pattern = true:suggestion


# ------------------------------------------------------------
# Modifiers
# ------------------------------------------------------------

dotnet_style_require_accessibility_modifiers = always:error


# ------------------------------------------------------------
# Parentheses
# ------------------------------------------------------------

dotnet_style_parentheses_in_arithmetic_binary_operators = always_for_clarity:suggestion
dotnet_style_parentheses_in_relational_binary_operators = always_for_clarity:suggestion
dotnet_style_parentheses_in_other_binary_operators = always_for_clarity:suggestion
dotnet_style_parentheses_in_other_operators = never_if_unnecessary:suggestion


# ------------------------------------------------------------
# Naming
# ------------------------------------------------------------

# Private fields: _camelCase
dotnet_naming_rule.private_fields_should_be_camel_case.severity = warning
dotnet_naming_rule.private_fields_should_be_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_should_be_camel_case.style = underscore_camel_case

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case


# Interfaces: IPascalCase
dotnet_naming_rule.interfaces_should_begin_with_i.severity = warning
dotnet_naming_rule.interfaces_should_begin_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_should_begin_with_i.style = interface_style

dotnet_naming_symbols.interfaces.applicable_kinds = interface

dotnet_naming_style.interface_style.required_prefix = I
dotnet_naming_style.interface_style.capitalization = pascal_case


# Types: PascalCase
dotnet_naming_rule.types_should_be_pascal_case.severity = warning
dotnet_naming_rule.types_should_be_pascal_case.symbols = types
dotnet_naming_rule.types_should_be_pascal_case.style = pascal_case

dotnet_naming_symbols.types.applicable_kinds = class, struct, interface, enum

dotnet_naming_style.pascal_case.capitalization = pascal_case


# ------------------------------------------------------------
# Analyzer severity
# ------------------------------------------------------------

# Namespace should be file-scoped
dotnet_diagnostic.IDE0161.severity = error

# Remove unnecessary usings
dotnet_diagnostic.IDE0005.severity = warning

# Explicit type instead of var
dotnet_diagnostic.IDE0007.severity = error
dotnet_diagnostic.IDE0008.severity = none


# ============================================================
# Project files
# ============================================================

[*.{csproj,props,targets}]
indent_style = space
indent_size = 2


# ============================================================
# JSON
# ============================================================

[*.json]
indent_style = space
indent_size = 2


# ============================================================
# XML
# ============================================================

[*.xml]
indent_style = space
indent_size = 2